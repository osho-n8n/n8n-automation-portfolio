    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// --- STEP 1: Clean & standardize incoming data ---\n\nlet rawName = $input.item.json[\"Full Name\"] || \"\";\nlet cleanedName = rawName\n  .trim()\n  .toLowerCase()\n  .split(\" \")\n  .filter(word => word.length > 0)\n  .map(word => word.charAt(0).toUpperCase() + word.slice(1))\n  .join(\" \");\n\nlet rawPhone = $input.item.json[\"Phone\"] || \"\";\nlet cleanedPhone = rawPhone.replace(/[^0-9+]/g, \"\");\n\nconst budget = $input.item.json[\"Budget (USD)\"];\nconst location = $input.item.json[\"Location\"];\nconst timeline = $input.item.json[\"Project Timeline\"];\nconst contactMethod = $input.item.json[\"Preferred Contact Method\"];\n\n// --- STEP 2: Score the lead ---\n\nlet budgetScore = 0;\nif (budget === \"$5,000+\") {\n  budgetScore = 40;\n} else if (budget === \"$2,000 - $4,999\") {\n  budgetScore = 25;\n} else {\n  budgetScore = 10;\n}\n\nlet locationScore = 0;\nif (location === \"Doha\") {\n  locationScore = 30;\n} else if (location === \"Other Gulf City\") {\n  locationScore = 20;\n} else {\n  locationScore = 10;\n}\n\nlet timelineScore = 0;\nif (timeline === \"Immediate\") {\n  timelineScore = 20;\n} else if (timeline === \"This Month\") {\n  timelineScore = 12;\n} else {\n  timelineScore = 5;\n}\n\nlet contactScore = 0;\nif (contactMethod === \"Phone Call\") {\n  contactScore = 10;\n} else {\n  contactScore = 5;\n}\n\nconst leadScore = budgetScore + locationScore + timelineScore + contactScore;\n\nlet leadTier = \"\";\nif (leadScore >= 70) {\n  leadTier = \"Hot\";\n} else if (leadScore >= 40) {\n  leadTier = \"Warm\";\n} else {\n  leadTier = \"Standard\";\n}\n\n// --- STEP 3: Return cleaned + scored data ---\n\nreturn {\n  json: {\n    ...$input.item.json,\n    \"Full Name\": cleanedName,\n    \"Phone\": cleanedPhone,\n    leadScore: leadScore,\n    leadTier: leadTier\n  }\n};"
      },
