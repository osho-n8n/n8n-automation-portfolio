    {
      "parameters": {
        "jsCode": "const leads = $input.all().filter(item => item.json && item.json.fields);\nconst count = leads.length;const hasHotLead = leads.some(item => item.json.fields[\"Lead Tier\"] === \"Hot\");\n\nlet summaryLines = leads.map((item, index) => {\n  const name = item.json.fields[\"Name\"] || \"Unknown\";\n  const company = item.json.fields[\"Company Name\"] || \"N/A\";\n  const contactMethod = item.json.fields[\"Preferred Contact Method\"] || \"N/A\";\n  return `${index + 1}. ${name} — ${company} — prefers ${contactMethod}`;\n});\n\nconst leadWord = count === 1 ? \"lead\" : \"leads\";\n\nconst summaryText = count === 0\n  ? \"No new leads today.\"\n  : summaryLines.join(\"\\n\");\n\nreturn [\n  {\n    json: {\n      leadCount: count,\n      leadWord: leadWord,\n      summaryText: summaryText,\n        priority: hasHotLead ? \"urgent\" : \"normal\",\n    }\n  }\n];"
      },
