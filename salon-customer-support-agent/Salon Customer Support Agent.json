        },
        "filterByFormula": "={{ /*n8n-auto-generated-fromAI-override*/ $fromAI('Filter_By_Formula', `Use this tool to search the salon's services database. Search by Service Name or Category when the customer asks about a specific service or type of service.\n\nSince customers rarely type exact service names, use partial matching for Service Name with FIND('keyword', {Service Name}) instead of exact equality (=). For example, to search for \"haircut\" use FIND('Haircut', {Service Name}) > 0, not {Service Name} = 'Haircut'.\n\nFor multi-word customer phrases (e.g. \"gel extensions\", \"hair coloring\"), do not search using the full phrase as one FIND string, since the customer's word order may not match the exact service name (e.g. the real service is \"Gel Nail Extensions\", not \"Gel Extensions\"). Instead, pick the single most distinctive word from the customer's phrase (e.g. \"Extensions\" or \"Gel\") and search using FIND with just that one word.\n\nDo not filter by the Available field in the search formula — always retrieve the matching record(s) first, then check the Available field in the result to tell the customer if that service is currently offered.\n\nWhen combining multiple conditions, use AND(condition1, condition2) or OR(condition1, condition2) syntax, for example: AND(FIND('Hair', {Category}) > 0, {Price (QAR)} < 200). Never write conditions side by side without AND()/OR() wrapping them.`, 'string') }}",
        "options": {}
      },
