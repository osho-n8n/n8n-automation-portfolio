    {
      "parameters": {
        "jsCode": "// Get all input items from Airtable Search\nconst rawItems = $input.all();\n// Filter out any empty/invalid items (zero-leads placeholder)\nconst leads = rawItems.filter(item => item.json.fields && item.json.fields['Name']);\n// Count total leads\nconst totalLeads = leads.length;\n// Count leads by tier\nconst hotLeads = leads.filter(item => item.json.fields['Lead Tier'] === 'Hot').length;\nconst warmLeads = leads.filter(item => item.json.fields['Lead Tier'] === 'Warm').length;\nconst standardLeads = leads.filter(item => item.json.fields['Lead Tier'] === 'Standard').length;\n// Average lead score, guarded against divide-by-zero\nconst totalScore = leads.reduce((sum, item) => sum + item.json.fields['Lead Score'], 0);\nconst averageScore = totalLeads > 0 ? Math.round(totalScore / totalLeads) : 0;\n// Lead names list\nconst leadNames = totalLeads > 0\n  ? leads.map(item => item.json.fields['Name']).join(', ')\n  : 'No leads this week';\n// Top lead (highest score)\nconst topLead = totalLeads > 0\n  ? leads.reduce((best, item) =>\n      item.json.fields['Lead Score'] > best.json.fields['Lead Score'] ? item : best\n    )\n  : null;\nconst topLeadName = topLead ? topLead.json.fields['Name'] : '';\nconst topLeadScore = topLead ? topLead.json.fields['Lead Score'] : 0;\n// Hot lead percentage\nconst hotLeadPercentage = totalLeads > 0 ? Math.round((hotLeads / totalLeads) * 100) : 0;\n// Busiest day of the week (using Luxon for correct timezone handling)\nlet busiestDay = '';\nif (totalLeads > 0) {\n  const dayNames = leads.map(item => {\n    return DateTime.fromISO(item.json.fields['Submission Date'])\n      .setZone('Asia/Qatar')\n      .toFormat('cccc');\n  });\n  const dayCounts = dayNames.reduce((counts, day) => {\n    counts[day] = (counts[day] || 0) + 1;\n    return counts;\n  }, {});\n  // Also track the earliest actual date for each weekday name, so we can sort chronologically\n  const dayDates = {};\n  leads.forEach(item => {\n    const dt = DateTime.fromISO(item.json.fields['Submission Date']).setZone('Asia/Qatar');\n    const dayName = dt.toFormat('cccc');\n    const dayValue = dt.toMillis();\n    if (!dayDates[dayName] || dayValue < dayDates[dayName]) {\n      dayDates[dayName] = dayValue;\n    }\n  });\n  // Find the highest lead count across all days\n  const maxCount = Math.max(...Object.values(dayCounts));\n  // Grab EVERY day that hit that max count (handles ties, not just the first match)\n  // then sort them chronologically using the actual date, not just discovery order\n  const busiestDays = Object.keys(dayCounts)\n    .filter(day => dayCounts[day] === maxCount)\n    .sort((a, b) => dayDates[a] - dayDates[b]);\n  // Join into a clean string: \"Monday\" alone, or \"Monday & Wednesday\" if tied (always in date order)\n  busiestDay = busiestDays.join(' & ');\n}\n// Return one summary object\nreturn [\n  {\n    json: {\n      totalLeads,\n      hotLeads,\n      warmLeads,\n      standardLeads,\n      averageScore,\n      leadNames,\n      reportDate: new Date().toLocaleDateString(),\n      hasLeads: totalLeads > 0,\n      topLeadName,\n      topLeadScore,\n      hotLeadPercentage,\n      busiestDay\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
